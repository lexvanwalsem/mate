{
  "manifest_version": 3,
  "name": "Zetje",
  "version": "0.1.0",
  "description": "Free local chess game analysis with Blokje the mascot. Works with chess.com, lichess and PGN.",
  "action": { "default_title": "Analyse this game with Zetje" },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus"],
  "host_permissions": ["https://lichess.org/*", "https://www.chess.com/*", "https://api.chess.com/*"],
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*", "https://www.chess.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
