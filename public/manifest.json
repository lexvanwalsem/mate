{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.9.1",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "action": { "default_title": "__MSG_actionTitle__" },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "scripting", "activeTab"],
  "host_permissions": ["https://lichess.org/*", "https://www.chess.com/*", "https://api.chess.com/*"],
  "content_scripts": [
    {
      "matches": ["https://lichess.org/*", "https://www.chess.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/blokje-16.png", "32": "icons/blokje-32.png", "48": "icons/blokje-48.png", "128": "icons/blokje-128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
