{
  "name": "zetje",
  "version": "0.15.0",
  "description": "Zetje — gratis, lokale schaakanalyse met Blokje de mascotte. Chrome-extensie voor chess.com, lichess en meer.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/make-icons.mjs",
    "build:app": "vite build",
    "build:ext": "cross-env EXT_ENTRY=content vite build --config vite.ext.config.ts && cross-env EXT_ENTRY=background vite build --config vite.ext.config.ts && cross-env EXT_ENTRY=duolingo vite build --config vite.ext.config.ts && cross-env EXT_ENTRY=duolingo-hook vite build --config vite.ext.config.ts",
    "build": "npm run icons && npm run build:app && npm run build:ext && node scripts/stamp-version.mjs",
    "typecheck": "tsc --noEmit",
    "check:lessons": "tsx scripts/check-lessons.ts",
    "test:ext": "node scripts/test-extension.mjs",
    "test:fit": "node scripts/test-fit.mjs",
    "test:explore": "node scripts/test-explore.mjs",
    "test:clocks": "node scripts/test-clocks.mjs",
    "test:practice": "node scripts/test-practice.mjs",
    "test:audit": "node scripts/test-audit.mjs",
    "preview": "vite preview --port 4173",
    "make-pieces": "node scripts/make-pieces.mjs",
    "render:mascot": "tsx scripts/render-mascot.tsx mascot-sheet.html",
    "test:style": "node scripts/test-style.mjs",
    "check:reactions": "tsx scripts/check-reactions.ts",
    "test:train": "node scripts/test-train.mjs",
    "test:puzzle": "node scripts/test-puzzle.mjs",
    "test:online": "node scripts/test-online.mjs",
    "check:duolingo": "tsx scripts/check-duolingo.ts",
    "test:duolingo": "node scripts/test-duolingo.mjs",
    "test:ending": "node scripts/test-ending.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "chess.js": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "sharp": "^0.33.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
